# ═══════════════════════════════════════════════════════════
#  مفاتيح مستقلة لكل بيئة — لا تشاركها إطلاقاً
#  استخدام نفس السر في البيئتين يوقف التشغيل تلقائياً
# ═══════════════════════════════════════════════════════════

# Testnet — من https://testnet.binance.vision
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Mainnet — لا تملأه إلا بعد اجتياز كل البوابات
# صلاحية Spot Trading فقط. Withdrawals مقفول. قيّد الـ IP.
MAINNET_API_KEY=
MAINNET_API_SECRET=

# ═══════════════════════════════════════════════════════════
#  التداول
# ═══════════════════════════════════════════════════════════
SYMBOL=BTCUSDT
INTERVAL=4h
CAPITAL=1000
MAX_POSITION_USD=50

# ═══════════════════════════════════════════════════════════
#  نموذج تكلفة الوضع الورقي (محافظ عمداً)
# ═══════════════════════════════════════════════════════════
GAP_SLIPPAGE_BPS=60
PAPER_LATENCY_MS=250
PAPER_PARTIAL_RATIO=0

# ═══════════════════════════════════════════════════════════
#  بوابات — لا تفعّلها إلا بقرار واعٍ
# ═══════════════════════════════════════════════════════════
# ALLOW_MAINNET=1
# I_HAVE_REVIEWED_AND_ACCEPT_RISK=yes

# ═══════════════════════════════════════════════════════════
#  التنبيهات — اختياري بالكامل. بلا ضبط = لا شيء يُرسَل (no-op آمن)
# ═══════════════════════════════════════════════════════════
# Telegram: أنشئ بوتاً عبر @BotFather واحصل على chat_id عبر @userinfobot
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=

# أو Webhook عام (Slack Incoming Webhook متوافق تقريباً)
# NOTIFY_WEBHOOK_URL=

# تبريد التنبيهات المتكررة لنفس الحدث (ثوانٍ) — يمنع إغراق قناتك
NOTIFY_COOLDOWN_SECONDS=300

# ═══════════════════════════════════════════════════════════
#  Dashboard V3 — عرض فقط
#  ⛔ لا مفاتيح تداول هنا. اللوحة لا تقرأها ولا تحتاجها.
# ═══════════════════════════════════════════════════════════

# ── مستوى البيئة: local | private | production ──
# local      : 127.0.0.1، مصادقة اختيارية، DEBUG مسموح
# private    : يتطلب SECRET_KEY + مصادقة، DEBUG ممنوع
# production : يضيف اشتراط HTTPS ورفض Origins غير مشفَّرة
DASHBOARD_ENVIRONMENT_TIER=local

# بيئة بيانات المحرك: shadow | monitor | paper | testnet
DASHBOARD_ENVIRONMENT=paper

DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8080

# ── المفتاح السري — إلزامي خارج local ──
# ولّده: python3 -c "import sys;sys.path.insert(0,'backend');
#         import config;print(config.generate_secret())"
# يُرفض إن كان: مفقوداً · أقصر من 32 · قيمة معروفة · ضعيف التنوّع
DASHBOARD_SECRET_KEY=

# ── المصادقة ──
# فارغ = تلقائي (اختيارية في local، إلزامية خارجها)
DASHBOARD_AUTH_REQUIRED=

# ولّد الهاش: python3 -c "import sys;sys.path.insert(0,'backend');
#             import security as s;print(s.hash_password('كلمتك'))"
# DASHBOARD_USERS=ops:pbkdf2_sha256$200000$...,viewer:pbkdf2_sha256$...

# خلف وكيل يتولّى المصادقة (Nginx / OIDC / VPN)
# DASHBOARD_TRUST_PROXY_AUTH=1

# ── الجلسات ──
DASHBOARD_SESSION_TTL_SECONDS=3600      # عمر أقصى
DASHBOARD_SESSION_IDLE_SECONDS=900      # انتهاء بالخمول
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_WINDOW=300
DASHBOARD_LOGIN_LOCKOUT=900

# ── HTTPS ──
DASHBOARD_HTTPS_ENABLED=0               # =1 بعد وضع TLS في الوكيل
DASHBOARD_SECURE_COOKIES=               # فارغ = تلقائي حسب HTTPS/tier

# ── التصحيح — ممنوع خارج local ──
DASHBOARD_DEBUG=0

# ── الحدود ──
# الحد العام. الحدود الفعلية بمجموعات:
# login=10 · heavy=30 · list=120 · light=300 (لكل دقيقة/IP)
DASHBOARD_RATE_LIMIT=240
CACHE_TTL=3

# ── CORS ── `*` يُرفض خارج local ولا يُعاد في أي رد
# DASHBOARD_CORS_ORIGIN=https://ops.internal,https://dash.internal

# ── تجاوز مسار القاعدة ──
# DATABASE_READ_ONLY_URL=/path/to/data/paper/paper.db
